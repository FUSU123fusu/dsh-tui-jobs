{
  "$schema": "https://dsh.community/schemas/dsh-plugin-0.15.json",
  "id": "dsh-tui-jobs",
  "name": "Jobs Panel",
  "version": "0.1.0",
  "manifestVersion": "0.15",
  "facets": {
    "host": {
      "entry": "lib/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "commands.dsh/v1alpha1",
        "kind": "Command"
      }
    ]
  },
  "permissions": [
    {
      "name": "commands.invoke",
      "scope": "declared command id dsh-tui-jobs.jobs",
      "reason": "The /jobs command lists, inspects and cancels background jobs from the ctx.jobs registry."
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "dsh-tui-jobs.jobs",
        "title": "Jobs Panel",
        "description": "List, watch, inspect output of, and cancel background jobs (bash, subagent, …)."
      }
    ]
  },
  "subscriptions": [],
  "license": "MIT",
  "source": {
    "repository": "https://github.com/FUSU123fusu/dsh-tui-jobs"
  },
  "compat": {
    "hosts": ["dsh-tui"]
  }
}
